{
  "name": "braingate",
  "version": "0.1.0-preview",
  "type": "module",
  "description": "One local control plane for the AI coding subscriptions you already use.",
  "license": "Apache-2.0",
  "keywords": [
    "ai",
    "cli",
    "claude-code",
    "codex",
    "grok",
    "antigravity",
    "copilot",
    "orchestration",
    "coding-agents",
    "developer-tools"
  ],
  "homepage": "https://github.com/Akadoorah/BrainGate#readme",
  "bugs": {
    "url": "https://github.com/Akadoorah/BrainGate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akadoorah/BrainGate.git"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "braingate": "./bin/braingate.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts",
    "test:integration": "BRAINGATE_INTEGRATION=1 tsx --test src/integration.test.ts",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs && node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs"
  },
  "dependencies": {
    "@braingate/context": "workspace:*",
    "@braingate/core": "workspace:*",
    "@braingate/dashboard": "workspace:*",
    "@braingate/dogfood": "workspace:*",
    "@braingate/execution": "workspace:*",
    "@braingate/goals": "workspace:*",
    "@braingate/memory": "workspace:*",
    "@braingate/observability": "workspace:*",
    "@braingate/operator": "workspace:*",
    "@braingate/providers": "workspace:*",
    "@braingate/router": "workspace:*",
    "@braingate/security": "workspace:*",
    "@braingate/shadow": "workspace:*",
    "@braingate/write": "workspace:*",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
